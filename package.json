{
  "name": "kurio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "npm run typecheck && vite build",
    "build:demo": "npm run build -- --mode demo",
    "preview": "vite preview --host 127.0.0.1",
